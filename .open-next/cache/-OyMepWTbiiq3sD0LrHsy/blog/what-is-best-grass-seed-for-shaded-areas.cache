 Guide to the Best Grass Seed for Sun \\u0026amp; Shade Lawns\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw\\\",\\\"className\\\":\\\"object-cover group-hover:scale-105 transition-transform duration-300\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"p-4 flex flex-col flex-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/grass-types\\\",\\\"className\\\":\\\"text-xs font-semibold text-[var(--color-primary)] uppercase tracking-wide mb-2 hover:underline\\\",\\\"children\\\":\\\"Grass Types\\\"}],[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/blog/best-grass-seed-for-sun-shade\\\",\\\"children\\\":[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-bold text-base leading-snug mb-2 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2\\\",\\\"children\\\":\\\"The Ultimate Guide to the Best Grass Seed for Sun \\u0026amp; Shade Lawns\\\"}]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-[var(--color-muted-fg)] line-clamp-2 flex-1\\\",\\\"children\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-3 flex items-center justify-between text-xs text-[var(--color-muted-fg)]\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"$undefined\\\"}],\\\"$undefined\\\"]}]]}]]}],[\\\"$\\\",\\\"article\\\",\\\"16968600\\\",{\\\"className\\\":\\\"group flex flex-col bg-white border border-[var(--color-border)] rounded-xl overflow-hidden hover:shadow-md transition-shadow\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/blog/best-grass-seed-for-full-sun\\\",\\\"className\\\":\\\"block relative aspect-[16/9] overflow-hidden bg-[var(--color-muted)]\\\",\\\"children\\\":[\\\"$\\\",\\\"$L20\\\",null,{\\\"src\\\":\\\"https://s.alicdn.com/@sc02/kf/A2d7b20f4642f48519477935ea27b3f2d2.jpg\\\",\\\"alt\\\":\\\"Best Grass Seed for Full Sun: Top Varieties \\u0026amp; Growing Guide\\\",\\\"fill\\\":true,\\\"si