ndary\\\"]\\na:[\\\"$\\\",\\\"li\\\",\\\"landscaping\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/landscaping\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Landscaping\\\"}]}]\\nb:[\\\"$\\\",\\\"li\\\",\\\"pest-control\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/pest-control\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Pest Control\\\"}]}]\\nc:[\\\"$\\\",\\\"li\\\",\\\"tree-care\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/tree-care\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Tree Care\\\"}]}]\\nd:[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-sm uppercase tracking-wider mb-3 text-white/80\\\",\\\"children\\\":\\\"Quick Links\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"/blog\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"All Articles\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/authors\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/authors\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Our Authors\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/about\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/about\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"About Us\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/contact\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/contact\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Contact\\\"}]}]]}]]}]\\ne:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"border-t border-white/10\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-[1280px] mx-auto px-4 sm:px-6 py-4 text-xs text-white/50\\\",\\\"children\\\":[\\\"© \\\",2026,\\\" LawnsGuide. All rights reserved.\\\"]}]}]\\nf:[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L5\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined\\\",\\\"errorStyles\\\":\\\"$undefined\\\",\\\"errorScripts\\\":\\\"$undefined\\\",\\\"template\\\":[\\\"$\\\",\\\"$L7\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":\\\"$undefined\\\",\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]]}]\\n10:[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L5\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined\\\",\\\"errorStyles\\\":\\\"$undefined\\\",\\\"errorScripts\\\":\\\"$undefined\\\",\\\"template\\\":[\\\"$\\\",\\\"$L7\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":\\\"$undefined\\\",\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]]}]\\n11:[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[\\\"$L16\\\",[[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"/_next/static/chunks/05-hs12ys24cd.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"$L17\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$18\\\",null,{\\\"name\\\":\\\"Next.MetadataOutlet\\\",\\\"children\\\":\\\"$@19\\\"}]}]]}]\\n1a:[]\\n12:\\\"$W1a\\\"\\n13:[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L1b\\\",null,{\\\"children\\\":\\\"$L1c\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$L1d\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$18\\\",null,