\"/_next/static/media/fba5a26ea33df6a3-s.p.0eehd8tgys7nv.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n0:{\"P\":null,\"c\":[\"\",\"blog\",\"diy-leaf-miner-control-vegetable-flower-gardens\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[\"blog\",{\"children\":[[\"slug\",\"diy-leaf-miner-control-vegetable-flower-gardens\",\"d\",null],{\"children\":[\"__PAGE__\",{}]}]}]},\"$undefined\",\"$undefined\",16],[[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0wx1umuyoep~6.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/0f3k24d_5_t~w.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"plus_jakarta_sans_7dfa5066-module__IpW-oW__variable\",\"children\":[[\"$\",\"head\",null,{\"children\":[[\"$\",\"link\",null,{\"rel\":\"icon\",\"href\":\"/icon.png?v=2\",\"type\":\"image/png\"}],[\"$\",\"$L2\",null,{\"id\":\"aplus\",\"strategy\":\"afterInteractive\",\"children\":\"window.APLUS_CONFIG={pid:'seo_vertical'};(function(w,d,s,q){w[q]=w[q]||[];var f=d.getElementsByTagName(s)[0],j=d.createElement(s);j.async=true;j.id='beacon-aplus';j.setAttribute('exparams','userid=&aplus&sidx=aplusSidex&ckx=aplusCkx');j.src='//g.alicdn.com/alilog/mlog/aplus_v2.js';j.crossorigin='anonymous';f.parentNode.insertBefore(j,f);})(window,document,'script','aplus_queue');var q=(window.aplus_queue||(window.aplus_queue=[]));q.push({action:'aplus.setPageSPM',arguments:['a27h9','46134557']});\"}],[\"$\",\"$L2\",null,{\"src\":\"https://www.googletagmanager.com/gtag/js?id=G-95PY8PSZ0Y\",\"strategy\":\"afterInteractive\"}],[\"$\",\"$L2\",null,{\"id\":\"google-analytics\",\"strategy\":\"afterInteractive\",\"children\":\"\\n          window.dataLayer = window.dataLayer || [];\\n          function gtag(){dataLayer.push(arguments);}\\n          gtag('js', new Date());\\n          gtag('config', 'G-95PY8PSZ0Y');\\n        \"}]]}],[\"$\",\"body\",null,{\"className\":\"flex flex-col min-h-dvh\",\"children\":[[\"$\",\"$L3\",null,{}],[\"$\",\"$L4\",null,{}],[\"$\",\"main\",null,{\"className\":\"flex-1\",\"children\":[\"$\",\"$L5\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$6\",\"errorStyles\":[],\"errorScripts\":[[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/0jhgiju6t94~i.js\",\"async\":true}]],\"template\":[\"$\",\"$L7\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center justify-center min-h-[60vh] px-4 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-6xl font-bold text-[var(--color-primary)] mb-4\",\"children\":\"404\"}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-3\",\"children\":\"Page Not Found\"}],[\"$\",\"p\",null,{\"className\":\"text-[var(--color-muted-fg)] mb-8 max-w-md\",\"children\":\"The page you're looking for doesn't exist or has been moved.\"}],[\"$\",\"$L8\",null,{\"href\":\"/\",\"className\":\"px-6 py-3 bg-[var(--color-primary)] text-white rounded-lg font-medium hover:bg-[var(--color-primary-light)] transition-colors\",\"children\":\"Back to Home\"}]]}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}],[\"$\",\"footer\",null,{\"className\":\"bg-[var(--color-primary-dark)] text-white mt-auto\",\"children\":[[\"$\",\"div\",null,{\"className\":\"max-w-[1280px] mx-auto px-4 sm:px-6 py-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:col-span-2\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/\",\"className\":\"flex items-center gap-2 font-bold text-xl mb-3\",\"children\":[[\"$\",\"$L9\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M11 20A7 7 0 0 1 9.