"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-[var(--color-muted-fg)] line-clamp-2 flex-1\",\"children\":\"$undefined\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex items-center justify-between text-xs text-[var(--color-muted-fg)]\",\"children\":[[\"$\",\"span\",null,{\"children\":\"$undefined\"}],\"$undefined\"]}]]}]]}],[\"$\",\"article\",\"13712896\",{\"className\":\"group flex flex-col bg-white border border-[var(--color-border)] rounded-xl overflow-hidden hover:shadow-md transition-shadow\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/blog/how-to-choose-the-right-grass-seed-for-your-lawn\",\"className\":\"block relative aspect-[16/9] overflow-hidden bg-[var(--color-muted)]\",\"children\":[\"$\",\"$L20\",null,{\"src\":\"https://s.alicdn.com/@sc02/kf/Ae61240c0f7f2427ab482848a70d3cc50d.jpg\",\"alt\":\"How to Choose the Right Grass Seed for Your Lawn: A Complete Guide\",\"fill\":true,\"sizes\":\"(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw\",\"className\":\"object-cover group-hover:scale-105 transition-transform duration-300\"}]}],[\"$\",\"div\",null,{\"className\":\"p-4 flex flex-col flex-1\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/categories/grass-types\",\"className\":\"text-xs font-semibold text-[var(--color-primary)] uppercase tracking-wide mb-2 hover:underline\",\"children\":\"Grass Types\"}],[\"$\",\"$L8\",null,{\"href\":\"/blog/how-to-choose-the-right-grass-seed-for-your-lawn\",\"children\":[\"$\",\"h2\",null,{\"className\":\"font-bold text-base leading-snug mb-2 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2\",\"children\":\"How to Choose the Right Grass Seed for Your Lawn: A Complete Guide\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-[var(--color-muted-fg)] line-clamp-2 flex-1\",\"children\":\"$undefined\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex items-center justify-between text-xs text-[var(--color-muted-fg)]\",\"children\":[[\"$\",\"span\",null,{\"children\":\"$undefined\"}],\"$undefined\"]}]]}]]}],[\"$\",\"article\",\"13712867\",{\"className\":\"group flex flex-col bg-white border border-[var(--color-border)] rounded-xl overflow-hidden hover:shadow-md transition-shadow\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/blog/best-grass-seed-for-clay-soil-full-sun\",\"className\":\"block relative aspect-[16/9] overflow-hidden bg-[var(--color-muted)]\",\"children\":[\"$\",\"$L20\",null,{\"src\":\"https://s.alicdn.com/@sc02/kf/A5d269f81b06545fdbf108148d27bb920m.jpg\",\"alt\":\"Best Grass Seed for Clay Soil in Full Sun: A Complete Guide\",\"fill\":true,\"sizes\":\"(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw\",\"className\":\"object-cover group-hover:scale-105 transition-transform duration-300\"}]}],\"$L24\"]}]]}]]}]\n24:[\"$\",\"div\",null,{\"className\":\"p-4 flex flex-col flex-1\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/categories/grass-types\",\"className\":\"text-xs font-semibold text-[var(--color-primary)] uppercase tracking-wide mb-2 hover:underline\",\"children\":\"Grass Types\"}],[\"$\",\"$L8\",null,{\"href\":\"/blog/best-grass-seed-for-clay-soil-full-sun\",\"children\":[\"$\",\"h2\",null,{\"className\":\"font-bold text-base leading-snug mb-2 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2\",\"children\":\"Best Grass Seed for Clay Soil in Full Sun: A Complete Guide\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-[var(--color-muted-fg)] line-clamp-2 flex-1\",\"children\":\"$undefined\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex items-center justify-between text-xs text-[var(--color-muted-fg)]\",\"children\":[[\"$\",\"span\",null,{\"children\":\"$undefined\"}],\"$undefined\"]}]]}]\n","segmentData":{"/_tree":":HL[\"/_next/static/chunks/0wx1umuyoep~6.css\",\"style\"]\n:HL[\"/_next/static/media/fba5a26ea33df6a3-s.p.0eehd8tgys7nv.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n0:{\"tree\":{\"name\":\"\",\"param\":null,\"prefetchHints\":16,\"slots\":{\"children\":{\"name\":\"b