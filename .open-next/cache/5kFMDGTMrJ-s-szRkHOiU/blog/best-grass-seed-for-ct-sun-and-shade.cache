r-wisconsin\",\"className\":\"block relative aspect-[16/9] overflow-hidden bg-[var(--color-muted)]\",\"children\":[\"$\",\"$L3\",null,{\"src\":\"https://s.alicdn.com/@sc02/kf/Ad4d8f93855f64eeb938df21b7ec890abU.jpg\",\"alt\":\"Best Grass Seed for Wisconsin: Top Varieties for a Lush, Hardy Lawn\",\"fill\":true,\"sizes\":\"(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw\",\"className\":\"object-cover group-hover:scale-105 transition-transform duration-300\"}]}],[\"$\",\"div\",null,{\"className\":\"p-4 flex flex-col flex-1\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/categories/grass-types\",\"className\":\"text-xs font-semibold text-[var(--color-primary)] uppercase tracking-wide mb-2 hover:underline\",\"children\":\"Grass Types\"}],[\"$\",\"$L2\",null,{\"href\":\"/blog/best-grass-seed-for-wisconsin\",\"children\":[\"$\",\"h2\",null,{\"className\":\"font-bold text-base leading-snug mb-2 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2\",\"children\":\"Best Grass Seed for Wisconsin: Top Varieties for a Lush, Hardy Lawn\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-[var(--color-muted-fg)] line-clamp-2 flex-1\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex items-center justify-between text-xs text-[var(--color-muted-fg)]\",\"children\":[[\"$\",\"span\",null,{}],\"$undefined\"]}]]}]]}],[\"$\",\"article\",\"13712896\",{\"className\":\"group flex flex-col bg-white border border-[var(--color-border)] rounded-xl overflow-hidden hover:shadow-md transition-shadow\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/blog/how-to-choose-the-right-grass-seed-for-your-lawn\",\"className\":\"block relative aspect-[16/9] overflow-hidden bg-[var(--color-muted)]\",\"children\":[\"$\",\"$L3\",null,{\"src\":\"https://s.alicdn.com/@sc02/kf/Ae61240c0f7f2427ab482848a70d3cc50d.jpg\",\"alt\":\"How to Choose the Right Grass Seed for Your Lawn: A Complete Guide\",\"fill\":true,\"sizes\":\"(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw\",\"className\":\"object-cover group-hover:scale-105 transition-transform duration-300\"}]}],[\"$\",\"div\",null,{\"className\":\"p-4 flex flex-col flex-1\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/categories/grass-types\",\"className\":\"text-xs font-semibold text-[var(--color-primary)] uppercase tracking-wide mb-2 hover:underline\",\"children\":\"Grass Types\"}],[\"$\",\"$L2\",null,{\"href\":\"/blog/how-to-choose-the-right-grass-seed-for-your-lawn\",\"children\":[\"$\",\"h2\",null,{\"className\":\"font-bold text-base leading-snug mb-2 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2\",\"children\":\"How to Choose the Right Grass Seed for Your Lawn: A Complete Guide\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-[var(--color-muted-fg)] line-clamp-2 flex-1\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex items-center justify-between text-xs text-[var(--color-muted-fg)]\",\"children\":[[\"$\",\"span\",null,{}],\"$undefined\"]}]]}]]}],[\"$\",\"article\",\"13712867\",{\"className\":\"group flex flex-col bg-white border border-[var(--color-border)] rounded-xl overflow-hidden hover:shadow-md transition-shadow\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/blog/best-grass-seed-for-clay-soil-full-sun\",\"className\":\"block relative aspect-[16/9] overflow-hidden bg-[var(--color-muted)]\",\"children\":[\"$\",\"$L3\",null,{\"src\":\"https://s.alicdn.com/@sc02/kf/A5d269f81b06545fdbf108148d27bb920m.jpg\",\"alt\":\"Best Grass Seed for Clay Soil in Full Sun: A Complete Guide\",\"fill\":true,\"sizes\":\"(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw\",\"className\":\"object-cover group-hover:scale-105 transition-transform duration-300\"}]}],\"$L9\"]}]]}]]}]\n7:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/05-hs12ys24cd.js\",\"async\":true}]\n8:[\"$\",\"$La\",null,{\"children\":[\"$\",\"$b\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@c\"}]}]\n9:[\"$\",\"div\",null,{\"className\":\"p-4 flex flex-col flex-1\",\"childre