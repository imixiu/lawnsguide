ng=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover group-hover:scale-105 transition-transform duration-300\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://s.alicdn.com/@sc02/kf/A5d269f81b06545fdbf108148d27bb920m.jpg\"/></a><div class=\"p-4 flex flex-col flex-1\"><a class=\"text-xs font-semibold text-[var(--color-primary)] uppercase tracking-wide mb-2 hover:underline\" href=\"/categories/grass-types\">Grass Types</a><a href=\"/blog/best-grass-seed-for-clay-soil-full-sun\"><h2 class=\"font-bold text-base leading-snug mb-2 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2\">Best Grass Seed for Clay Soil in Full Sun: A Complete Guide</h2></a><p class=\"text-sm text-[var(--color-muted-fg)] line-clamp-2 flex-1\"></p><div class=\"mt-3 flex items-center justify-between text-xs text-[var(--color-muted-fg)]\"><span></span></div></div></article></div></div></div><!--$--><!--/$--></main><footer class=\"bg-[var(--color-primary-dark)] text-white mt-auto\"><div class=\"max-w-[1280px] mx-auto px-4 sm:px-6 py-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8\"><div class=\"lg:col-span-2\"><a class=\"flex items-center gap-2 font-bold text-xl mb-3\" href=\"/\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-leaf\" aria-hidden=\"true\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"></path><path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"></path></svg> LawnsGuide</a><p class=\"text-sm text-white/70 max-w-xs leading-relaxed\">Expert lawn care, landscaping, and gardening guides to help you grow a beautiful outdoor space.</p></div><div><h3 class=\"font-semibold text-sm uppercase tracking-wider mb-3 text-white/80\">Categories</h3><ul class=\"space-y-2\"