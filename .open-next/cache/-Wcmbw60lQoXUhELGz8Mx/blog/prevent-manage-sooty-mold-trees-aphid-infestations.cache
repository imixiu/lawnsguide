 hover:shadow-md transition-shadow\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/blog/best-time-prune-flowering-ornamental-trees\",\"className\":\"block relative aspect-[16/9] overflow-hidden bg-[var(--color-muted)]\",\"children\":[\"$\",\"$L20\",null,{\"src\":\"https://s.alicdn.com/@sc02/kf/A2e339f1445c54ce5bdcd3ee4141a6128P.jpg\",\"alt\":\"Best Time to Prune Flowering Ornamental Trees: A Complete Guide\",\"fill\":true,\"sizes\":\"(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw\",\"className\":\"object-cover group-hover:scale-105 transition-transform duration-300\"}]}],[\"$\",\"div\",null,{\"className\":\"p-4 flex flex-col flex-1\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/categories/tree-care\",\"className\":\"text-xs font-semibold text-[var(--color-primary)] uppercase tracking-wide mb-2 hover:underline\",\"children\":\"Tree Care\"}],[\"$\",\"$L8\",null,{\"href\":\"/blog/best-time-prune-flowering-ornamental-trees\",\"children\":[\"$\",\"h2\",null,{\"className\":\"font-bold text-base leading-snug mb-2 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2\",\"children\":\"Best Time to Prune Flowering Ornamental Trees: A Complete Guide\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-[var(--color-muted-fg)] line-clamp-2 flex-1\",\"children\":\"$undefined\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex items-center justify-between text-xs text-[var(--color-muted-fg)]\",\"children\":[[\"$\",\"span\",null,{\"children\":\"$undefined\"}],\"$undefined\"]}]]}]]}],[\"$\",\"article\",\"6978461\",{\"className\":\"group flex flex-col bg-white border border-[var(--color-border)] rounded-xl overflow-hidden hover:shadow-md transition-shadow\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/blog/identify-treat-anthracnose-shade-trees\",\"className\":\"block relative aspect-[16/9] overflow-hidden bg-[var(--color-muted)]\",\"children\":[\"$\",\"$L20\",null,{\"src\":\"https://s.alicdn.com/@sc02/kf/A9ab3119169e54210a10c8b54484e728eO.jpg\",\"alt\"