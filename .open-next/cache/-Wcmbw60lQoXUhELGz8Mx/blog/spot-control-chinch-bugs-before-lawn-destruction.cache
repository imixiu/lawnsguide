SZ0Y\\\",\\\"strategy\\\":\\\"afterInteractive\\\"}],[\\\"$\\\",\\\"$L2\\\",null,{\\\"id\\\":\\\"google-analytics\\\",\\\"strategy\\\":\\\"afterInteractive\\\",\\\"children\\\":\\\"\\\\n          window.dataLayer = window.dataLayer || [];\\\\n          function gtag(){dataLayer.push(arguments);}\\\\n          gtag('js', new Date());\\\\n          gtag('config', 'G-95PY8PSZ0Y');\\\\n        \\\"}]]}],[\\\"$\\\",\\\"body\\\",null,{\\\"className\\\":\\\"flex flex-col min-h-dvh\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L3\\\",null,{}],[\\\"$\\\",\\\"$L4\\\",null,{}],[\\\"$\\\",\\\"main\\\",null,{\\\"className\\\":\\\"flex-1\\\",\\\"children\\\":[\\\"$\\\",\\\"$L5\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$6\\\",\\\"errorStyles\\\":[],\\\"errorScripts\\\":[[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"/_next/static/chunks/0jhgiju6t94~i.js\\\",\\\"async\\\":true}]],\\\"template\\\":[\\\"$\\\",\\\"$L7\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-col items-center justify-center min-h-[60vh] px-4 text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"text-6xl font-bold text-[var(--color-primary)] mb-4\\\",\\\"children\\\":\\\"404\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold mb-3\\\",\\\"children\\\":\\\"Page Not Found\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[var(--color-muted-fg)] mb-8 max-w-md\\\",\\\"children\\\":\\\"The page you're looking for doesn't exist or has been moved.\\\"}],[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/\\\",\\\"className\\\":\\\"px-6 py-3 bg-[var(--color-primary)] text-white rounded-lg font-medium hover:bg-[var(--color-primary-light)] transition-colors\\\",\\\"children\\\":\\\"Back to Home\\\"}]]}],[]],\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]}],[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"bg-[var(--color-primary-dark)] text-white mt-auto\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-[1280px] mx-auto px-4 sm:px-6 py-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"lg:col-span-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/\\\",\\\"className\\\":\\\"flex items-center gap-2 font-bold text-xl mb-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L9\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\\\",\\\"key\\\":\\\"nnexq3\\\"}],[\\\"path\\\",{\\\"d\\\":\\\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\\\",\\\"key\\\":\\\"mt58a7\\\"}]],\\\"className\\\":\\\"lucide-leaf\\\",\\\"size\\\":20}],\\\" LawnsGuide\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-white/70 max-w-xs leading-relaxed\\\",\\\"children\\\":\\\"Expert lawn care, landscaping, and gardening guides to help you grow a beautiful outdoor space.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-sm uppercase tracking-wider mb-3 text-white/80\\\",\\\"children\\\":\\\"Categories\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"lawn-care\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/lawn-care\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Lawn Care\\\"}]}],\\\"$La\\\",\\\"$Lb\\\",\\\"$Lc\\\"]}]]}],\\\"$Ld\\\"]}],\\\"$Le\\\"]}]]}]]}]]}],{\\\"children\\\":[\\\"$Lf\\\",{\\\"children\\\":[\\\"$L10\\\",{\\\"children\\\":[\\\"$L11\\\",{},null,false,null]},null,false,\\\"$@12\\\"]},null,false,\\\"$@12\\\"]},null,false,null],\\\"$L13\\\",false]],\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$14\\\",[\\\"$L15\\\"]],\\\"S\\\":true,\\\"h\\\":null,\\\"s\\\":\\\"$undefined\\\",\\\"l\\\":\\\"$undefined\\\",\\\"p\\\":\\\"$undefined\\\",\\\"d\\\":\\\"$undefined\\\",\\\"b\\\":\\\"-Wcmbw60lQoXUhELGz8Mx\\\"}\\n\"])</script><script>self.__next_f.push([1,\"17:I[97367,[\\\"/_next/static/chunks/0mkh1ezli734p.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"OutletBoundary\\\"]\\n18:\\\"$Sreact.suspense\\\"\\n1b:I[97367,[\\\"/_next/static/chunks/0mkh1ezli734p.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"ViewportBoundary\\\"]\\n1d:I[97367,[\\\"/_next/static/chunks/0mkh1ezli734p.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"MetadataBoundary\\\"]\\na:[\\\"$\\\",\\\"li\\\",\\\"landscaping\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/landscaping\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Landscaping\\\"}]}]\\nb:[\\\"$\\\",\\\"li\\\",\\\"pest-control\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/pest-control\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Pest Control\\\"}]}]\\nc:[\\\"$\\\",\\\"li\\\",\\\"tree-care\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/tree-care\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Tree Care\\\"}]}]\\nd:[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-sm uppercase tracking-wider mb-3 text-white/80\\\",\\\"children\\\":\\\"Quick Links\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"/blog\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"All Articles\\\