e\\\":\\\"text-6xl font-bold text-[var(--color-primary)] mb-4\\\",\\\"children\\\":\\\"404\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold mb-3\\\",\\\"children\\\":\\\"Page Not Found\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[var(--color-muted-fg)] mb-8 max-w-md\\\",\\\"children\\\":\\\"The page you're looking for doesn't exist or has been moved.\\\"}],[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/\\\",\\\"className\\\":\\\"px-6 py-3 bg-[var(--color-primary)] text-white rounded-lg font-medium hover:bg-[var(--color-primary-light)] transition-colors\\\",\\\"children\\\":\\\"Back to Home\\\"}]]}],[]],\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]}],[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"bg-[var(--color-primary-dark)] text-white mt-auto\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-[1280px] mx-auto px-4 sm:px-6 py-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"lg:col-span-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/\\\",\\\"className\\\":\\\"flex items-center gap-2 font-bold text-xl mb-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L9\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\\\",\\\"key\\\":\\\"nnexq3\\\"}],[\\\"path\\\",{\\\"d\\\":\\\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\\\",\\\"key\\\":\\\"mt58a7\\\"}]],\\\"className\\\":\\\"lucide-leaf\\\",\\\"size\\\":20}],\\\" LawnsGuide\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-white/70 max-w-xs leading-relaxed\\\",\\\"children\\\":\\\"Expert lawn care, landscaping, and gardening guides to help you grow a beautiful outdoor space.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-sem