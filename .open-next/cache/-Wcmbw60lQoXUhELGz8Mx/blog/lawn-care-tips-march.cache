ver:shadow-md transition-shadow\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/blog/lawn-care-help-wanted-near-me\",\"className\":\"block relative aspect-[16/9] overflow-hidden bg-[var(--color-muted)]\",\"children\":[\"$\",\"$L1f\",null,{\"src\":\"https://s.alicdn.com/@sc02/kf/A122a1fa71b24440b90c471224fcf0dc8Z.jpg\",\"alt\":\"Lawn Care Help Wanted Near Me: How to Find & Hire the Best Local Lawn Care Services\",\"fill\":true,\"sizes\":\"(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw\",\"className\":\"object-cover group-hover:scale-105 transition-transform duration-300\"}]}],[\"$\",\"div\",null,{\"className\":\"p-4 flex flex-col flex-1\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/categories/lawn-care\",\"className\":\"text-xs font-semibold text-[var(--color-primary)] uppercase tracking-wide mb-2 hover:underline\",\"children\":\"Lawn Care\"}],[\"$\",\"$L8\",null,{\"href\":\"/blog/lawn-care-help-wanted-near-me\",\"children\":[\"$\",\"h2\",null,{\"className\":\"font-bold text-base leading-snug mb-2 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2\",\"children\":\"Lawn Care Help Wanted Near Me: How to Find & Hire the Best Local Lawn Care Services\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-[var(--color-muted-fg)] line-clamp-2 flex-1\",\"children\":\"$undefined\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex items-center justify-between text-xs text-[var(--color-muted-fg)]\",\"children\":[[\"$\",\"span\",null,{\"children\":\"$undefined\"}],\"$undefined\"]}]]}]]}],[\"$\",\"article\",\"6978458\",{\"className\":\"group flex flex-col bg-white border border-[var(--color-border)] rounded-xl overflow-hidden hover:shadow-md transition-shadow\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/blog/lawn-care-tips-for-summer\",\"className\":\"block relative aspect-[16/9] overflow-hidden bg-[var(--color-muted)]\",\"children\":[\"$\",\"$L1f\",null,{\"src\":\"https://s.alicdn.com/@sc02/kf/Ae26bec52eae24ff9badddaa1a67c4d4b5.jpg\",\"alt\":\"Lawn Care Tips for Summer: The Complete Guide to a Healthy Lawn\",\"fill\":true,\"sizes\":\"(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw\",\"className\":\"object-cover group-hover:scale-105 transition-transform duration-300\"}]}],\"$L23\"]}]]}]]}]\n23:[\"$\",\"div\",null,{\"className\":\"p-4 flex flex-col flex-1\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/categories/lawn-care\",\"className\":\"text-xs font-semibold text-[var(--color-primary)] uppercase tracking-wide mb-2 hover:underline\",\"children\":\"Lawn Care\"}],[\"$\",\"$L8\",null,{\"href\":\"/blog/lawn-care-tips-for-summer\",\"children\":[\"$\",\"h2\",null,{\"className\":\"font-bold text-base leading-snug mb-2 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2\",\"children\":\"Lawn Care Tips for Summer: The Complete Guide to a Healthy Lawn\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-[var(--color-muted-fg)] line-clamp-2 flex-1\",\"children\":\"$undefined\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex items-center justify-between text-xs text-[var(--color-muted-fg)]\",\"children\":[[\"$\",\"span\",null,{\"children\":\"$undefined\"}],\"$undefined\"]}]]}]\n","segmentData":{"/_tree":":HL[\"/_next/static/chunks/01-z273murnol.css\",\"style\"]\n:HL[\"/_next/static/media/fba5a26ea33df6a3-s.p.0eehd8tgys7nv.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n0:{\"tree\":{\"name\":\"\",\"param\":null,\"prefetchHints\":16,\"slots\":{\"children\":{\"name\":\"blog\",\"param\":null,\"prefetchHints\":0,\"slots\":{\"children\":{\"name\":\"slug\",\"param\":{\"type\":\"d\",\"key\":\"lawn-care-tips-march\",\"siblings\":null},\"prefetchHints\":0,\"slots\":{\"children\":{\"name\":\"__PAGE__\",\"param\":null,\"prefetchHints\":0,\"slots\":null}}}}}}},\"staleTime\":300,\"buildId\":\"-Wcmbw60lQoXUhELGz8Mx\"}\n","/_full":"1:\"$Sreact.fragment\"\n2:I[79520,[\"/_next/static/chunks/0mkh1ezli734p.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"\"]\n3:I[98840,[\"/_next/static