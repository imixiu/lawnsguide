\\",\\\"d\\\",null],{\\\"children\\\":[\\\"__PAGE__\\\",{}]}]}]},\\\"$undefined\\\",\\\"$undefined\\\",16],[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/01-z273murnol.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"/_next/static/chunks/0mkh1ezli734p.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"script\\\",\\\"script-1\\\",{\\\"src\\\":\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"en\\\",\\\"className\\\":\\\"plus_jakarta_sans_7dfa5066-module__IpW-oW__variable\\\",\\\"children\\\":[[\\\"$\\\",\\\"head\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"link\\\",null,{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/icon.png?v=2\\\",\\\"type\\\":\\\"image/png\\\"}],[\\\"$\\\",\\\"$L2\\\",null,{\\\"id\\\":\\\"aplus\\\",\\\"strategy\\\":\\\"afterInteractive\\\",\\\"children\\\":\\\"window.APLUS_CONFIG={pid:'seo_vertical'};(function(w,d,s,q){w[q]=w[q]||[];var f=d.getElementsByTagName(s)[0],j=d.createElement(s);j.async=true;j.id='beacon-aplus';j.setAttribute('exparams','userid=\\u0026aplus\\u0026sidx=aplusSidex\\u0026ckx=aplusCkx');j.src='//g.alicdn.com/alilog/mlog/aplus_v2.js';j.crossorigin='anonymous';f.parentNode.insertBefore(j,f);})(window,document,'script','aplus_queue');var q=(window.aplus_queue||(window.aplus_queue=[]));q.push({action:'aplus.setPageSPM',arguments:['a27h9','46134557']});\\\"}],[\\\"$\\\",\\\"$L2\\\",null,{\\\"src\\\":\\\"https://www.googletagmanager.com/gtag/js?id=G-95PY8PSZ0Y\\\",\\\"strategy\\\":\\\"afterInteractive\\\"}],[\\\"$\\\",\\\"$L2\\\",null,{\\\"id\\\":\\\"google-analytics\\\",\\\"strategy\\\":\\\"afterInteractive\\\",\\\"children\\\":\\\"\\\\n          window.dataLayer = window.dataLayer ||