:grid-cols-4 gap-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"lg:col-span-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/\\\",\\\"className\\\":\\\"flex items-center gap-2 font-bold text-xl mb-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L9\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\\\",\\\"key\\\":\\\"nnexq3\\\"}],[\\\"path\\\",{\\\"d\\\":\\\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\\\",\\\"key\\\":\\\"mt58a7\\\"}]],\\\"className\\\":\\\"lucide-leaf\\\",\\\"size\\\":20}],\\\" LawnsGuide\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-white/70 max-w-xs leading-relaxed\\\",\\\"children\\\":\\\"Expert lawn care, landscaping, and gardening guides to help you grow a beautiful outdoor space.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-sm uppercase tracking-wider mb-3 text-white/80\\\",\\\"children\\\":\\\"Categories\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"lawn-care\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/lawn-care\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Lawn Care\\\"}]}],\\\"$La\\\",\\\"$Lb\\\",\\\"$Lc\\\"]}]]}],\\\"$Ld\\\"]}],\\\"$Le\\\"]}]]}]]}]]}],{\\\"children\\\":[\\\"$Lf\\\",{\\\"children\\\":[\\\"$L10\\\",{\\\"children\\\":[\\\"$L11\\\",{},null,false,null]},null,false,\\\"$@12\\\"]},null,false,\\\"$@12\\\"]},null,false,null],\\\"$L13\\\",false]],\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$14\\\",[\\\"$L15\\\"]],\\\"S\\\":true,\\\"h\\\":null,\\\"s\\\":\\\"$undefined\\\",\\\"l\\\":\\\"$undefined\\\",\\\"p\\\":\\\"$undefined\\\",\\\"d\\\":\\\"$undefined\\\",\\\"b\\\":\\\"-Wcmbw60lQoXUhELGz8Mx\\\"}\\n\"])</script><script>self.__next_f.push([1,\"17:I[97367,[\\\"/_next/static/chunks/0mkh1ezli734p.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"OutletBoundary\\\"]\\n18:\\\"$Sreact.suspense\\\"\\n1b:I[97367,[\\\"/_next/static/chunks/0mkh1ezli734p.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"ViewportBoundary\\\"]\\n1d:I[97367,[\\\"/_next/static/chunks/0mkh1ezli734p.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"MetadataBoundary\\\"]\\na:[\\\"$\\\",\\\"li\\\",\\\"landscaping\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/landscaping\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Landscaping\\\"}]}]\\nb:[\\\"$\\\",\\\"li\\\",\\\"pest-control\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/pest-control\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Pest Control\\\"}]}]\\nc:[\\\"$\\\",\\\"li\\\",\\\"tree-care\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/tree-care\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Tree Care\\\"}]}]\\nd:[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-sm uppercase tracking-wider mb-3 text-white/80\\\",\\\"children\\\":\\\"Quick Links\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"space-y-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"/blog\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"All Articles\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"/authors\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/authors\\\",\\\"className\\\":\\\"text-sm text-white/70 hover:text-white transition-colors\\\",\\\"children\\\":\\\"Our Auth