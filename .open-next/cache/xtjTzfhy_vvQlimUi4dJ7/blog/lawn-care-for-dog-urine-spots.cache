text-[var(--color-primary)] uppercase tracking-wide mb-2 hover:underline\\\",\\\"children\\\":\\\"Lawn Care\\\"}]\\n24:[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/blog/lawn-care-organic-near-me\\\",\\\"children\\\":[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-bold text-base leading-snug mb-2 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2\\\",\\\"children\\\":\\\"The Complete Guide to Finding and Using Organic Lawn Care Near You\\\"}]}]\\n25:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-[var(--color-muted-fg)] line-clamp-2 flex-1\\\",\\\"children\\\":\\\"$undefined\\\"}]\\n26:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-3 flex items-center justify-between text-xs text-[var(--color-muted-fg)]\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"$undefined\\\"}],\\\"$undefined\\\"]}]\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[79520,[\"/_next/static/chunks/0mkh1ezli734p.js\"],\"\"]\n3:I[98840,[\"/_next/static/chunks/0mkh1ezli734p.js\"],\"default\"]\n4:I[70119,[\"/_next/static/chunks/0mkh1ezli734p.js\"],\"default\"]\n5:I[39756,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n6:I[8821,[\"/_next/static/chunks/0mkh1ezli734p.js\",\"/_next/static/chunks/0jhgiju6t94~i.js\"],\"default\"]\n7:I[37457,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n8:I[22016,[\"/_next/static/chunks/0mkh1ezli734p.js\",\"/_next/static/chunks/16joj-w8x5b8c.js\"],\"\"]\n9:I[5014,[\"/_next/static/chunks/0mkh1ezli734p.js\"],\"default\"]\n13:I[68027,[\"/_next/static/chunks/0mkh1ezli734p.js\"],\"default\",1]\n:HL[\"/_next/static/chunks/05kf.z2-bz_84.css\",\"style\"]\n:HL[\"/_next/static/media/fba5a26ea33df6a3-s.p.0eehd8tgys7nv.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n0:{\"P\":null,\"c\":[\"\",\"blog\",\"lawn-care-for-dog-urine-spots\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"c