:{\"name\":\"blog\",\"param\":null,\"prefetchHints\":0,\"slots\":{\"children\":{\"name\":\"slug\",\"param\":{\"type\":\"d\",\"key\":\"groundhog-removal-tips\",\"siblings\":null},\"prefetchHints\":0,\"slots\":{\"children\":{\"name\":\"__PAGE__\",\"param\":null,\"prefetchHints\":0,\"slots\":null}}}}}}},\"staleTime\":300,\"buildId\":\"xtjTzfhy_vvQlimUi4dJ7\"}\n","/_full":"1:\"$Sreact.fragment\"\n2:I[79520,[\"/_next/static/chunks/0mkh1ezli734p.js\"],\"\"]\n3:I[98840,[\"/_next/static/chunks/0mkh1ezli734p.js\"],\"default\"]\n4:I[70119,[\"/_next/static/chunks/0mkh1ezli734p.js\"],\"default\"]\n5:I[39756,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n6:I[8821,[\"/_next/static/chunks/0mkh1ezli734p.js\",\"/_next/static/chunks/0jhgiju6t94~i.js\"],\"default\"]\n7:I[37457,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n8:I[22016,[\"/_next/static/chunks/0mkh1ezli734p.js\",\"/_next/static/chunks/16joj-w8x5b8c.js\"],\"\"]\n9:I[5014,[\"/_next/static/chunks/0mkh1ezli734p.js\"],\"default\"]\n13:I[68027,[\"/_next/static/chunks/0mkh1ezli734p.js\"],\"default\",1]\n:HL[\"/_next/static/chunks/05kf.z2-bz_84.css\",\"style\"]\n:HL[\"/_next/static/media/fba5a26ea33df6a3-s.p.0eehd8tgys7nv.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n0:{\"P\":null,\"c\":[\"\",\"blog\",\"groundhog-removal-tips\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[\"blog\",{\"children\":[[\"slug\",\"groundhog-removal-tips\",\"d\",null],{\"children\":[\"__PAGE__\",{}]}]}]},\"$undefined\",\"$undefined\",16],[[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/05kf.z2-bz_84.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/0mkh1ezli734p.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"className\