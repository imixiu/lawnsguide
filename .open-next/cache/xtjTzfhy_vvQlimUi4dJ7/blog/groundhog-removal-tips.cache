ll\\\":true,\\\"sizes\\\":\\\"(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw\\\",\\\"className\\\":\\\"object-cover group-hover:scale-105 transition-transform duration-300\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"p-4 flex flex-col flex-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/pest-control\\\",\\\"className\\\":\\\"text-xs font-semibold text-[var(--color-primary)] uppercase tracking-wide mb-2 hover:underline\\\",\\\"children\\\":\\\"Pest Control\\\"}],[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/blog/deer-resistant-plants\\\",\\\"children\\\":[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-bold text-base leading-snug mb-2 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2\\\",\\\"children\\\":\\\"The Ultimate Guide to Deer Resistant Plants for a Beautiful Landscape\\\"}]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-[var(--color-muted-fg)] line-clamp-2 flex-1\\\",\\\"children\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-3 flex items-center justify-between text-xs text-[var(--color-muted-fg)]\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"$undefined\\\"}],\\\"$undefined\\\"]}]]}]]}],[\\\"$\\\",\\\"article\\\",\\\"2547915\\\",{\\\"className\\\":\\\"group flex flex-col bg-white border border-[var(--color-border)] rounded-xl overflow-hidden hover:shadow-md transition-shadow\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/blog/snake-prevention-garden\\\",\\\"className\\\":\\\"block relative aspect-[16/9] overflow-hidden bg-[var(--color-muted)]\\\",\\\"children\\\":[\\\"$\\\",\\\"$L1f\\\",null,{\\\"src\\\":\\\"https://s.alicdn.com/@sc02/kf/A6b4a16d6a8c84a7f814c9741701b39b4o.jpg\\\",\\\"alt\\\":\\\"The Ultimate Guide to Snake Prevention in Your Garden\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw\\\",\\\"className\\\":\\\"object-cov