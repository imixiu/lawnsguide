e\\\",\\\"children\\\":[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-bold text-base leading-snug mb-2 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2\\\",\\\"children\\\":\\\"The Ultimate Guide to Cedar Tree Care: Planting, Pruning, \\u0026amp; Maintenance\\\"}]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-[var(--color-muted-fg)] line-clamp-2 flex-1\\\",\\\"children\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-3 flex items-center justify-between text-xs text-[var(--color-muted-fg)]\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"$undefined\\\"}],\\\"$undefined\\\"]}]]}]]}],[\\\"$\\\",\\\"article\\\",\\\"2547916\\\",{\\\"className\\\":\\\"group flex flex-col bg-white border border-[var(--color-border)] rounded-xl overflow-hidden hover:shadow-md transition-shadow\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/blog/cypress-tree-maintenance\\\",\\\"className\\\":\\\"block relative aspect-[16/9] overflow-hidden bg-[var(--color-muted)]\\\",\\\"children\\\":[\\\"$\\\",\\\"$L1f\\\",null,{\\\"src\\\":\\\"https://s.alicdn.com/@sc02/kf/Abbd96130a01847afb9765bf6dabbb57cb.jpg\\\",\\\"alt\\\":\\\"The Ultimate Guide to Cypress Tree Maintenance: Care, Pruning, \\u0026amp; Disease Prevention\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw\\\",\\\"className\\\":\\\"object-cover group-hover:scale-105 transition-transform duration-300\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"p-4 flex flex-col flex-1\\\",\\\"children\\\":[\\\"$L23\\\",\\\"$L24\\\",\\\"$L25\\\",\\\"$L26\\\"]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"23:[\\\"$\\\",\\\"$L8\\\",null,{\\\"href\\\":\\\"/categories/tree-care\\\",\\\"className\\\":\\\"text-xs font-semibold text-[var(--color-primary)] uppercase tracking-wide mb-2 hover:underline\\\",\\\"children\\\":\\\"Tree Care\\\"}]\\n24:[\\\"$\\\",\\\"$L8\\\",null,