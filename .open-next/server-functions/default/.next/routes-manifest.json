{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/author/:slug",
      "destination": "/authors/:slug",
      "statusCode": 308,
      "regex": "^(?!/_next)/author(?:/([^/]+?))(?:/)?$"
    },
    {
      "source": "/landscaping",
      "destination": "/categories/landscaping",
      "statusCode": 308,
      "regex": "^(?!/_next)/landscaping(?:/)?$"
    },
    {
      "source": "/lawn-care",
      "destination": "/categories/lawn-care",
      "statusCode": 308,
      "regex": "^(?!/_next)/lawn-care(?:/)?$"
    },
    {
      "source": "/pest-control",
      "destination": "/categories/pest-control",
      "statusCode": 308,
      "regex": "^(?!/_next)/pest-control(?:/)?$"
    },
    {
      "source": "/tree-care",
      "destination": "/categories/tree-care",
      "statusCode": 308,
      "regex": "^(?!/_next)/tree-care(?:/)?$"
    },
    {
      "source": "/gardening",
      "destination": "/categories/gardening",
      "statusCode": 308,
      "regex": "^(?!/_next)/gardening(?:/)?$"
    },
    {
      "source": "/home-garden",
      "destination": "/categories/home-garden",
      "statusCode": 308,
      "regex": "^(?!/_next)/home-garden(?:/)?$"
    },
    {
      "source": "/home-and-garden",
      "destination": "/categories/home-garden",
      "statusCode": 308,
      "regex": "^(?!/_next)/home-and-garden(?:/)?$"
    },
    {
      "source": "/grass-types",
      "destination": "/categories/home-garden",
      "statusCode": 308,
      "regex": "^(?!/_next)/grass-types(?:/)?$"
    },
    {
      "source": "/sitemap/sitemapindex.xml",
      "destination": "/sitemap.xml",
      "statusCode": 308,
      "regex": "^(?!/_next)/sitemap/sitemapindex\\.xml(?:/)?$"
    },
    {
      "source": "/sitemap/sitemap1.xml",
      "destination": "/sitemap.xml",
      "statusCode": 308,
      "regex": "^(?!/_next)/sitemap/sitemap1\\.xml(?:/)?$"
    },
    {
      "source": "/sitemap/sitemap2.xml",
      "destination": "/sitemap.xml",
      "statusCode": 308,
      "regex": "^(?!/_next)/sitemap/sitemap2\\.xml(?:/)?$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/authors/[slug]",
      "regex": "^/authors/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/authors/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/blog/[slug]",
      "regex": "^/blog/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/blog/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/categories/[slug]",
      "regex": "^/categories/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/categories/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[type]/[slug]",
      "regex": "^/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtype": "nxtPtype",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPtype>[^/]+?)/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/api/debug-author",
      "regex": "^/api/debug\\-author(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/debug\\-author(?:/)?$"
    },
    {
      "page": "/api/test-db",
      "regex": "^/api/test\\-db(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/test\\-db(?:/)?$"
    },
    {
      "page": "/authors",
      "regex": "^/authors(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/authors(?:/)?$"
    },
    {
      "page": "/blog",
      "regex": "^/blog(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/blog(?:/)?$"
    },
    {
      "page": "/categories",
      "regex": "^/categories(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/categories(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/icon.png",
      "regex": "^/icon\\.png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.png(?:/)?$"
    },
    {
      "page": "/privacy-policy",
      "regex": "^/privacy\\-policy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy\\-policy(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/terms-of-service",
      "regex": "^/terms\\-of\\-service(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/terms\\-of\\-service(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}